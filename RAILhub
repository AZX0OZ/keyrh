local Junkie = nil

local function ensureJunkieSDK()
    if Junkie then
        return Junkie
    end

    local cacheSdkFile = Config.saveDir .. "/junkie_sdk.lua"
    -- 1. Try local disk cache first for instant execution and 0 network usage on server hops
    local cachedCode = SafeFunc.readFile(cacheSdkFile)
    if cachedCode and type(cachedCode) == "string" and #cachedCode > 100 and not cachedCode:find("429: Too Many Requests") and not cachedCode:find("<html") then
        local loader = loadstring(cachedCode)
        if loader then
            local okInst, inst = pcall(loader)
            if okInst and inst then
                Junkie = inst
                if type(Config.service) == "string" and Config.service ~= "" then Junkie.service = Config.service end
                if type(Config.identifier) == "string" and Config.identifier ~= "" then Junkie.identifier = Config.identifier end
                if type(Config.provider) == "string" and Config.provider ~= "" then Junkie.provider = Config.provider end
                return Junkie
            end
        end
    end

    -- 2. Fallback to network mirrors with strict validation
    local urls = {
        "https://jnkie.com/sdk/library.lua",
        "https://raw.githubusercontent.com/AZX0OZ/junkie-sdk/main/library.lua",
    }
    for attempt = 1, 3 do
        for _, u in ipairs(urls) do
            local code = SafeFunc.httpGet(u)
            if code and type(code) == "string" and #code > 100 and not code:find("429: Too Many Requests") and not code:find("<html") then
                local loader = loadstring(code)
                if loader then
                    local okInst, inst = pcall(loader)
                    if okInst and inst then
                        pcall(function()
                            ensureDir(cacheSdkFile)
                            SafeFunc.writeFile(cacheSdkFile, code)
                        end)
                        Junkie = inst
                        if type(Config.service) == "string" and Config.service ~= "" then Junkie.service = Config.service end
                        if type(Config.identifier) == "string" and Config.identifier ~= "" then Junkie.identifier = Config.identifier end
                        if type(Config.provider) == "string" and Config.provider ~= "" then Junkie.provider = Config.provider end
                        return Junkie
                    end
                end
            end
        end
        if attempt < 3 then task.wait(0.5) end
    end
    return nil
end

