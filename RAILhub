local function parseExpirationToTimestamp(val)
    if val == nil or val == false then return nil end
    if type(val) == "number" then
        if val <= 0 then return 0 end
        if val > 1e11 then
            return math.floor(val / 1000)
        elseif val < 100000000 then
            return math.floor(os.time() + val)
        else
            return math.floor(val)
        end
    end
    if type(val) == "string" then
        local num = tonumber(val)
        if num then
            if num > 1e11 then
                return math.floor(num / 1000)
            elseif num < 100000000 then
                return math.floor(os.time() + num)
            else
                return math.floor(num)
            end
        end
        local y, mo, d, h, min, s = val:match("(%d%d%d%d)%-(%d%d)%-(%d%d)[T%s]+(%d%d):(%d%d):?(%d*)")
        if y and mo and d and h and min then
            local sec = tonumber(s) or 0
            local dt = {
                year = tonumber(y),
                month = tonumber(mo),
                day = tonumber(d),
                hour = tonumber(h),
                min = tonumber(min),
                sec = sec,
                isdst = false
            }
            local ok, parsed = pcall(os.time, dt)
            if ok and parsed then
                -- Jnkie API отдаёт время в UTC ("...Z" / "+00:00"), а os.time считает
                -- таблицу локальным временем. Без поправки у UTC+X игроков ключ
                -- hourly offset fix applies only with explicit UTC suffix.
                local tail = val:match("%s*([Zz])%s*$") and "Z" or val:match("([%+%-]%d%d:?%d%d)%s*$")
                if tail then
                    local okOff, localOff = pcall(function()
                        return os.difftime(os.time(), os.time(os.date("!*t")))
                    end)
                    if okOff and localOff then
                        local zoneOff = 0
                        if tail ~= "Z" then
                            local sign, zh, zm = tail:match("([%+%-])(%d%d):?(%d%d)")
                            if zh then
                                zoneOff = (tonumber(zh) * 3600 + tonumber(zm) * 60) * (sign == "-" and -1 or 1)
                            end
                        end
                        parsed = parsed - localOff - zoneOff
                    end
                end
                return parsed
            end
        end
    end
    return nil
end

local function findDeepField(tbl, names, maxDepth)
    if type(tbl) ~= "table" then return nil end
    maxDepth = maxDepth or 3
    if maxDepth <= 0 then return nil end
    
    for _, name in ipairs(names) do
        if tbl[name] ~= nil then return tbl[name] end
        for k, v in pairs(tbl) do
            if type(k) == "string" and k:lower() == name:lower() then
                return v
            end
        end
    end
    
    local subKeys = { "key", "data", "result", "info", "payload", "key_data", "keyData", "keyInfo", "key_info", "response" }
