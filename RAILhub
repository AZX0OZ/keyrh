local function fetchMainViaWorker(session)
    if type(session) ~= "table" or type(session.token) ~= "string" then return nil, "NO_TOKEN" end
    local gid = ""
    local plc = ""
    pcall(function()
        if game.GameId and game.GameId ~= 0 then
            gid = tostring(game.GameId)
        end
        if game.PlaceId and game.PlaceId ~= 0 then
            plc = tostring(game.PlaceId)
        end
    end)
    -- 1. Fetch game payload from VPS Worker POST /payload (Strictly in RAM, zero disk write)
    local data, err = workerPOST(Config.workerPayloadPath or "/payload", {
        token = session.token,
        hwid = getDeviceIdentifier(),
        gameId = gid,
        place = plc,
        universe = gid,
