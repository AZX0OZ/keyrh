local function parseValidationResult(value)
    if value == true then
        return true, nil
    end
    if value == false or value == nil then
        return false, nil
    end
    if type(value) == "table" then
        if value.valid == true or value.success == true then
            return true, nil
        end
        local msg = value.error or value.message or value.code
        if type(value.error) == "table" then
            msg = value.error.message or value.error.code or value.error.reason or msg
        end
        if type(msg) == "string" and msg ~= "" then
            return false, msg
        end
        return false, nil
    end
    if type(value) == "string" then
        if value ~= "" then
            return false, value
        end
        return false, nil
    end
    return false, nil
end

local function isRetryableValidationError(message)
    local msg = tostring(message or "")
    if msg == "" then
        return false
    end
    local upper = string.upper(msg)
    if upper:find("429", 1, true) or upper:find("RATE_LIMIT", 1, true) then
        return false
    end
    if upper:find("INVALID", 1, true) or upper:find("EXPIRED", 1, true) or upper:find("BANNED", 1, true) then
        return false
    end
    if upper:find("MISMATCH", 1, true) or upper:find("ALREADY_USED", 1, true) or upper:find("DISABLED", 1, true) then
        return false
    end
    if upper:find("TIMEOUT", 1, true) or upper:find("CONNECTION", 1, true) then
        return true
    end
    return false
end

