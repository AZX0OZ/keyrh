local function exportKeyRuntimeData(data, key)
    if not key then
        key = rawget(_G, "JD_KEY") or (getgenv and getgenv().SCRIPT_KEY) or CurrentKey
    end
    
    if type(data) ~= "table" and Config.api and Config.api ~= "" then
        local apiData = fetchKeyMetadataFromAPI(key)
        if type(apiData) == "table" then
            data = apiData
        end
    end

    if type(data) ~= "table" and type(verifiedKeyData) == "table" then
        data = verifiedKeyData
    end
    
    local rawExpires = findDeepField(data, {
        "expires_at", "expiresAt", "expire_at", "expireAt",
        "expiration", "expires", "valid_until", "validUntil",
        "expiry", "expire_date", "expireDate", "expiration_date",
        "time_left", "timeLeft", "remaining", "duration", "remaining_seconds"
    })
    if not rawExpires and type(Junkie) == "table" then
        rawExpires = findDeepField(Junkie, {
            "expires_at", "expiresAt", "expire_at", "expireAt",
            "expiration", "expires", "valid_until", "validUntil",
            "expiry", "time_left", "remaining"
        })
    end
    local expiresAt = parseExpirationToTimestamp(rawExpires)

    local folderName = findDeepField(data, { "folder_name", "folderName", "folder", "folder_title", "folderTitle", "folder_id", "folderId", "group", "tier" })
    if not folderName and type(Junkie) == "table" then
        folderName = findDeepField(Junkie, { "folder_name", "folderName", "folder", "folder_title", "folderTitle" })
    end

    local isPremiumVal = findDeepField(data, { "is_premium", "isPremium", "premium", "is_vip", "isVip", "vip" })
    local fLow = folderName and tostring(folderName):lower() or ""
    local isPremium = (isPremiumVal == true) or (fLow == "premium" or fLow == "paid" or fLow == "giveaway" or fLow:find("paid", 1, true) ~= nil or fLow:find("giveaway", 1, true) ~= nil)
    if not isPremium and type(Junkie) == "table" then
        local jPrem = findDeepField(Junkie, { "is_premium", "isPremium", "premium" })
        if jPrem == true then isPremium = true end
    end

    local function isLifetimeFolderName(fn)
        local s = tostring(fn or ""):lower()
        if s == "" then return false end
        if s == "lifetime" or s == "permanent" or s == "paid" or s == "giveaway" then return true end
        if s:find("lifetime", 1, true) or s:find("permanent", 1, true) or s:find("giveaway", 1, true) or s:find("paid", 1, true) then return true end
        return false
    end

    local isLifetimeVal = findDeepField(data, { "is_lifetime", "isLifetime", "lifetime", "permanent" })
    -- ВАЖНО (доки Jnkie): SDK check_key возвращает ТОЛЬКО {valid,is_keyless,is_premium,message}
    -- без дат и папок. Отсутствие expires в ответе означает "данных нет", а НЕ lifetime.
    local isLifetime = (isLifetimeVal == true) or isLifetimeFolderName(folderName)
    if not isLifetime and type(Junkie) == "table" then
        local jLife = findDeepField(Junkie, { "is_lifetime", "isLifetime", "lifetime", "permanent" })
        if jLife == true then isLifetime = true end
    end
    -- Лимит без даты (напр. неиспользованный ключ с expiry_on_first_use, воркер шлёт
    -- validity_minutes) — это НЕ lifetime, даже для paid/premium.
    local validityVal = findDeepField(data, { "validity_minutes", "validityMinutes", "validity" })
    if validityVal ~= nil and tonumber(validityVal) and tonumber(validityVal) > 0 then
        isLifetime = false
    end
    -- УДАЛЕНО старое правило "premium/paid без даты => lifetime": именно оно ставило
    -- Lifetime всем платным ключам в SDK-фолбэке (у SDK-ответа дат нет по контракту).

    if isLifetime then
        expiresAt = nil
    elseif not expiresAt and key and key ~= "" then
        expiresAt = getOrInitLocalExpiration(key, folderName, isLifetime, isPremium)
    end

    pcall(function()
        local metaFile = Config.saveDir .. "/railhub_key_meta.json"
        local HttpService = game:GetService("HttpService")
        if writefile then
            if makefolder and not isfolder(Config.saveDir) then pcall(makefolder, Config.saveDir) end
            writefile(metaFile, HttpService:JSONEncode({
                key = key,
                is_lifetime = isLifetime == true,
                is_premium = isPremium == true,
                folder_name = folderName and tostring(folderName) or (isPremium and "Paid" or "Default"),
                expires_at = expiresAt
            }))
        end
    end)

    local discordUser = findDeepField(data, { "discord_username", "discordUsername", "discord_name", "username", "discord" })
    local discordId = findDeepField(data, { "discord_id", "discordId" })

    pcall(function()
        if getgenv then
            getgenv().JD_RAW_RESPONSE = data
            getgenv().JD_EXPIRES_AT = expiresAt
            getgenv().JD_IS_PREMIUM = isPremium
            if folderName then getgenv().JD_FOLDER_NAME = tostring(folderName) end
            if discordUser then getgenv().JD_DISCORD_USERNAME = tostring(discordUser) end
            if discordId then getgenv().JD_DISCORD_ID = tostring(discordId) end
            getgenv().JD_REASON = "KEY_VALID"
            if key then getgenv().JD_KEY = key end
        end
    end)
    
    _G.JD_RAW_RESPONSE = data
    _G.JD_EXPIRES_AT = expiresAt
    _G.JD_IS_PREMIUM = isPremium
    if folderName then _G.JD_FOLDER_NAME = tostring(folderName) end
    if discordUser then _G.JD_DISCORD_USERNAME = tostring(discordUser) end
    if discordId then _G.JD_DISCORD_ID = tostring(discordId) end
    _G.JD_REASON = "KEY_VALID"
    if key then _G.JD_KEY = key end
end

