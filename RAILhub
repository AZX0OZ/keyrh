local linkCooldowns = {}

local function getKeyLink(providerCategory)
    local now = os.clock()
    local lastClick = linkCooldowns[providerCategory] or 0
    if (now - lastClick) < 4 then
        local waitSec = math.ceil(4 - (now - lastClick))
        notify("Please wait " .. waitSec .. " seconds.", 2)
        return
    end
    linkCooldowns[providerCategory] = now

    GetKeyButton.Text = "Generating..."

    task.spawn(function()
        local candidateList = (Config.providers and Config.providers[providerCategory]) or {providerCategory}
        local generatedLink = nil
        local lastError = nil

        local junkieInst = ensureJunkieSDK()
        for _, candidateName in ipairs(candidateList) do
            if junkieInst then
                junkieInst.provider = candidateName
            end
            
            local ok, link, err = pcall(function()
                if not junkieInst then return nil end
                return junkieInst.get_key_link(candidateName)
            end)

            if ok and type(link) == "string" and link ~= "" and link:find("http", 1, true) then
                generatedLink = link
                break
            else
                local errMsg = err
                if type(link) == "string" and link ~= "" then
                    errMsg = link
                end
                lastError = errMsg
                if errMsg == "RATE_LIMITED" or errMsg == "RATE_LIMITTED" then
                    break
                end
            end
            task.wait(0.1)
        end

        if generatedLink then
            SafeFunc.setClipboard(generatedLink)
            SafeFunc.openUrl(generatedLink)

            if providerCategory == "lootlabs" then
                notify("Link copied! (Disable AdBlock / VPN)", 4)
            else
                notify("Link copied to clipboard!", 3)
            end

            GetKeyButton.Text = "Copied!"
            task.wait(2)
            GetKeyButton.Text = "Get Key (" .. (selectedProvider == "workink" and "Work.ink" or "LootLabs") .. ")"
        else
            if lastError == "RATE_LIMITED" or lastError == "RATE_LIMITTED" then
                notify("Rate limited. Wait 5 minutes.", 4)
            else
                notify("Failed to generate link.", 3)
            end

            GetKeyButton.Text = "Failed"
            task.wait(2)
            GetKeyButton.Text = "Get Key (" .. (selectedProvider == "workink" and "Work.ink" or "LootLabs") .. ")"
        end
    end)
end

local function validateKey()
    if hwidBanDetected then
        return
    end
    if verifying then return end
    
    local key = (KeyInput.Text or ""):gsub("%s+", "")
    
    if key == "" then
        notify("Please enter a key", 3)
        return
    end
    
    verifying = true

    local function restoreDefaultButton()
        safeUI(function()
            CheckKeyButton.Text = "Check Key"
            CheckKeyButton.TextSize = 16
        end)
        Tween(CheckKeyButton, {BackgroundColor3 = Color3.fromRGB(20, 20, 20)}, 0.3)
    end

    task.spawn(function()
        local completed = false
        task.delay(20, function()
            if not completed and verifying then
                verifying = false
                restoreDefaultButton()
                notify("Verification timeout. Try again.", 3)
            end
        end)

        local ok, err = pcall(function()
            safeUI(function()
                CheckKeyButton.Text = "VERIFYING..."
                CheckKeyButton.TextSize = 14
            end)
            Tween(CheckKeyButton, {BackgroundColor3 = Color3.fromRGB(15, 15, 15)}, 0.2)

            safeWait(0.1, 0.2)

            -- 1. Сначала быстрая и надежная проверка через серверный бэкенд
            local session, serverErr = requestServerSession(key)
            if not session and not key:find("RAIL|hub-", 1, true) then
                local prefKey = "RAIL|hub-" .. key
                local prefSession, prefErr = requestServerSession(prefKey)
                if prefSession then
                    key = prefKey
                    session = prefSession
                    serverErr = nil
                else
                    serverErr = prefErr or serverErr
                end
            end

            if session then
                saveKey(key)
                AuthorizedSession = session
                pcall(function()
                    _G.RAILhub_KeyAuthorized = true
                    if getgenv then
                        getgenv().SCRIPT_KEY = key
                        getgenv().RAILhub_KeyAuthorized = true
                    end
                    if shared then
                        shared.RAILhub_KeyAuthorized = true
                    end
                end)
                exportKeyRuntimeData(session.data or verifiedKeyData, key)

                Tween(CheckKeyButton, {BackgroundColor3 = Color3.fromRGB(40, 40, 40)}, 0.3)
                safeUI(function()
                    CheckKeyButton.Text = "AUTHORIZED"
                end)
                safeWait(0.25, 0.4)
                startMainScriptAndClose()
                return
            end

            -- 2. Если есть ответ с ошибкой от бэкенда
            if serverErr and serverErr ~= "SERVER_UNREACHABLE" and not serverErr:find("CONNECTION_FAILED", 1, true) and serverErr ~= "NO_HTTP_SUPPORT" then
                handleValidationMessage(serverErr)
                Tween(CheckKeyButton, {BackgroundColor3 = Color3.fromRGB(30, 30, 30)}, 0.3)
                safeUI(function() CheckKeyButton.Text = "FAILED" end)
                task.wait(0.7)
                restoreDefaultButton()
                verifying = false
                completed = true
                return
            end

            -- 3. Фолбэк на Junkie SDK (если сервер был недоступен)
            local junkieInst = ensureJunkieSDK()
            if junkieInst then
                local okCheck, checkRes = pcall(function()
                    return junkieInst.check_key(key)
                end)
                if okCheck and type(checkRes) == "table" and checkRes.valid == true then
                    local localSess = { token = "direct_valid", exp = 0, data = checkRes }
                    saveKey(key)
                    AuthorizedSession = localSess
                    pcall(function()
                        if getgenv then getgenv().SCRIPT_KEY = key end
                    end)
                    exportKeyRuntimeData(checkRes, key)
                    Tween(CheckKeyButton, {BackgroundColor3 = Color3.fromRGB(40, 40, 40)}, 0.3)
                    safeUI(function() CheckKeyButton.Text = "AUTHORIZED" end)
                    safeWait(0.25, 0.4)
                    startMainScriptAndClose()
                    return
                elseif okCheck and type(checkRes) == "table" and checkRes.err then
                    serverErr = tostring(checkRes.err)
                end
            end

            handleValidationMessage(serverErr or "SERVER_UNREACHABLE")
            Tween(CheckKeyButton, {BackgroundColor3 = Color3.fromRGB(30, 30, 30)}, 0.3)
            safeUI(function() CheckKeyButton.Text = "FAILED" end)
            task.wait(0.7)
            restoreDefaultButton()
        end)

        completed = true
        verifying = false

        if not ok then
            notify("Verification error. Try again.", 3)
            restoreDefaultButton()
        end
    end)
end

