local SafeFunc = {}

SafeFunc.httpGet = function(url)
    if type(url) ~= "string" or url == "" then
        return nil
    end

    local methods = {}

    if game and game.HttpGet then
        table.insert(methods, function()
            return game:HttpGet(url)
        end)
    end

    if game and game.HttpGetAsync then
        table.insert(methods, function()
            return game:HttpGetAsync(url)
        end)
    end

    local reqFn = (syn and syn.request) or (http and http.request) or request or http_request or (fluxus and fluxus.request)
    if reqFn then
        table.insert(methods, function()
            local res = reqFn({
                Url = url,
                Method = "GET",
                Headers = {
                    ["User-Agent"] = "Roblox/" .. tostring(game.PlaceId or 0),
                }
            })
            if type(res) ~= "table" then
                return nil
            end
            if res.Success == false then
                return nil
            end
            if type(res.StatusCode) == "number" and (res.StatusCode < 200 or res.StatusCode >= 300) then
                return nil
            end
            if type(res.Body) == "string" then
                return res.Body
            end
            return nil
        end)
    end

    for _, method in ipairs(methods) do
        local ok, result = pcall(method)
        if ok and result and type(result) == "string" and #result > 0 then
            return result
        end
    end

    return nil
end

