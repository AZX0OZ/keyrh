    })
    if data and data.ok == true and type(data.code) == "string" and #data.code > 100 and not data.code:find("<html") then
        return data.code, nil
    end

    -- 2. Fallback to mirrors strictly in RAM if VPS network request had timeout
    local fallbackUrls = {
        "https://raw.githubusercontent.com/AZX0OZ/12123/refs/heads/main/yba.lua",
        "https://cdn.jsdelivr.net/gh/AZX0OZ/12123@main/yba.lua",
        "https://fastgit.han17.fun/AZX0OZ/12123/raw/main/yba.lua",
    }
    for _, u in ipairs(fallbackUrls) do
        local ok, res = pcall(function() return game:HttpGet(u) end)
        if ok and type(res) == "string" and #res > 100 and not res:find("429: Too Many Requests") and not res:find("<html") then
            return res, nil
        end
    end

    return nil, tostring(data and (data.err or data.error) or err or "NO_PAYLOAD")
end

local TEMP_SESSION_SALT = "RAILhub_TMP_7f3K9qZ2_2602xQ"

local function computeTempSig(key, deviceId, verifiedAt, expiresAt)
    local raw = string.format("%s|%s|%s|%s|%s", tostring(key), tostring(deviceId), tostring(verifiedAt), tostring(expiresAt or 0), TEMP_SESSION_SALT)
    local h1 = 2166136261
    local h2 = 5381
    local bxor = (bit32 and bit32.bxor) or (bit and bit.bxor)
    for i = 1, #raw do
        local b = string.byte(raw, i)
        if bxor then
            h1 = bxor(h1, b)
            h1 = (h1 * 16777619) % 4294967296
            h2 = (((h2 * 32) + h2) + b) % 4294967296
        else
            h1 = ((h1 * 31) + b) % 4294967296
            h2 = ((h2 * 33) + b) % 4294967296
        end
    end
    return string.format("%08x%08x", h1, h2)
end

