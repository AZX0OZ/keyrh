local function requestServerSession(key)
    -- POST /verify {key,hwid,...} -> {ok=true, token="...", exp=..., data={...}} или {ok=false, err="..."}
    local clean = tostring(key or ""):gsub("%s+", "")
    if clean == "" then return nil, "EMPTY_KEY" end
    local lp = getLocalPlayer()
    local mainHwid, clientId, rawGhwid = getDeviceIdentifier()
    local payload = {
        key = clean,
        hwid = mainHwid,
        clientId = clientId,
        ghwid = rawGhwid,
        service = Config.service,
        identifier = Config.identifier,
        nick = (lp and tostring(lp.Name)) or "?",
        displayName = (lp and tostring(lp.DisplayName)) or "?",
        userid = (lp and tostring(lp.UserId)) or "0",
        place = tostring(game.PlaceId),
        placeId = tostring(game.PlaceId),
        gameId = tostring(game.GameId or 0),
        executor = getExecutorName(),
    }
    local data, err = workerPOST(Config.workerVerifyPath or "/verify", payload)
    if not data then return nil, err or "REQUEST_ERROR" end
    if data.ok == true and type(data.token) == "string" and data.token ~= "" then
        return { token = data.token, exp = data.exp, data = data.data }, nil
    end
    return nil, tostring(data.err or data.error or data.message or "KEY_INVALID")
end

