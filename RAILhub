    end)
    local rawCid = (cid and type(cid) == "string" and cid ~= "" and cid ~= "default_device") and tostring(cid):gsub("%s+", "") or nil

    local persistentId = nil
    pcall(function()
        local fpFile = Config.saveDir .. "/device_id.dat"
        if readfile and isfile and isfile(fpFile) then
            local c = readfile(fpFile)
            if type(c) == "string" and c ~= "" then
                persistentId = c:gsub("%s+", "")
