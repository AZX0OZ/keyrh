local function runMainScriptDirect(session)
    session = session or AuthorizedSession
    if type(session) ~= "table" or type(session.token) ~= "string" or session.token == "" then
        return
    end
    if (_G and _G.__RAILHUB_SPAWNING_MAIN) or (getgenv and getgenv().__RAILHUB_SPAWNING_MAIN) or (shared and shared.__RAILHUB_SPAWNING_MAIN) then
        warn("[RAILhub] Main script already launching! Skipping duplicate spawn.")
        return
    end
    _G.__RAILHUB_SPAWNING_MAIN = true
    if getgenv then getgenv().__RAILHUB_SPAWNING_MAIN = true end
    if shared then shared.__RAILHUB_SPAWNING_MAIN = true end

    AuthorizedSession = session

    pcall(function()
        _G.__RAIL_session = session
        _G.RAILhub_KeyAuthorized = true
        if getgenv then
            getgenv().__RAIL_session = session
            getgenv().RAILhub_KeyAuthorized = true
        end
        if shared then
            shared.__RAIL_session = session
            shared.RAILhub_KeyAuthorized = true
        end
    end)

    exportKeyRuntimeData(session.data or verifiedKeyData, rawget(_G, "JD_KEY") or (getgenv and getgenv().SCRIPT_KEY) or CurrentKey)
    local recheckTick = 0
    task.spawn(function()
        pcall(function()
            local HS = game:GetService("HttpService")
            local req = (syn and syn.request) or request or http_request or (http and http.request)
            if not req then return end
            while true do
                pcall(function()
                    local lp = game:GetService("Players").LocalPlayer
                    local hwid = getDeviceIdentifier()
                    local execName = getExecutorName()
                    local curKey = rawget(_G, "JD_KEY") or (getgenv and getgenv().SCRIPT_KEY) or CurrentKey or ""
                    workerPOST(Config.workerHeartbeatPath or "/heartbeat", {
                        key = tostring(curKey),
                        hwid = tostring(hwid),
                        nick = lp and tostring(lp.Name) or "?",
                        userid = lp and tostring(lp.UserId) or "0",
                        place = tostring(game.PlaceId),
                        mode = tostring(rawget(_G, "RAILhub_Mode") or "farm"),
                        executor = execName
                    })
                end)
                recheckTick = recheckTick + 1
                if recheckTick >= 3 then
                    recheckTick = 0
                    pcall(function()
                        local okV, errV = validateSessionWithWorker(AuthorizedSession)
                        if not okV and errV and (errV == "KEY_EXPIRED" or errV == "KEY_INVALIDATED" or errV == "ALREADY_USED" or errV == "KEY_INVALID" or errV == "HWID_MISMATCH" or errV == "SERVICE_MISMATCH" or errV == "HWID_BANNED") then
                            if errV == "HWID_BANNED" then
                                kickHwidBanned(errV)
                            else
                                game:GetService("Players").LocalPlayer:Kick("Key revoked: " .. tostring(errV))
                            end
                        end
                    end)
                end
                task.wait(300)
            end
        end)
    end)

    task.spawn(function()
        local code, ferr = fetchMainViaWorker(AuthorizedSession)
        if code and #code > 100 then
            local fn, compileErr = loadstring(code)
            if fn then
                _G.RAILhub_ScriptRunning = true
                if getgenv then getgenv().RAILhub_ScriptRunning = true end
                if shared then shared.RAILhub_ScriptRunning = true end
                clearLoadingFlags()
                local okRun, runErr = pcall(fn, AuthorizedSession)
                if not okRun then
                    _G.RAILhub_ScriptRunning = false
                    if getgenv then getgenv().RAILhub_ScriptRunning = false end
                    if shared then shared.RAILhub_ScriptRunning = false end
                    clearLoadingFlags()
                    warn("[RAILhub] Execution error in game script:", tostring(runErr))
                    pcall(function() notify("Script error: " .. tostring(runErr):sub(1, 40), 5) end)
                else
                    pcall(function() destroyNotificationUI() end)
                end
            else
                clearLoadingFlags()
                warn("[RAILhub] Compile error in game script:", tostring(compileErr))
                pcall(function() notify("Failed to parse script. Try rejoining.", 5) end)
            end
        else
            clearLoadingFlags()
            warn("[RAILhub] Failed to load payload:", tostring(ferr))
            pcall(function() notify("Failed to load payload: " .. tostring(ferr), 5) end)
        end
    end)
end

local startupKey = CurrentKey
local startupError = nil
if startupKey == "" and AutoCheck then
    startupKey = getStartupKey():gsub("%s+", "")
