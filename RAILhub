local function workerPOST(path, tbl, timeout)
    local reqFn = (syn and syn.request) or request or http_request or (http and http.request)
    if not reqFn then return nil, "NO_HTTP_SUPPORT" end
    local HS = game:GetService("HttpService")
    local okEnc, body = pcall(function() return HS:JSONEncode(tbl) end)
    if not okEnc then return nil, "ENCODE_FAIL" end
    
    local endpoints = (Config and Config.endpoints) or {
        "http://157.22.193.72",
        "http://45.82.13.95:3000",
        "https://45.82.13.95.nip.io",
        "https://157.22.193.72.nip.io",
    }
    
    local lastError = nil
    local lastFailData = nil
    for _, base in ipairs(endpoints) do
        local ok, res = pcall(function()
            return reqFn({
                Url = base .. path,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["User-Agent"] = "Roblox/0"
                },
                Body = body,
                Timeout = 4,
                timeout = 4
            })
        end)
        if ok and res and type(res) == "table" then
            local statusCode = tonumber(res.StatusCode or res.status_code or res.Status) or 200
            local txt = res.Body or res.body or ""
            if type(txt) == "string" and txt ~= "" then
                local okDec, data = pcall(function() return HS:JSONDecode(txt) end)
                if okDec and type(data) == "table" then
                    if data.ok == true then
                        return data, nil
                    else
                        lastFailData = data
                        lastError = data.err or data.error or ("ERROR_" .. tostring(statusCode))
                    end
                else
                    lastError = "INVALID_SERVER_RESPONSE (Status " .. tostring(statusCode) .. ")"
                end
            else
                lastError = "EMPTY_SERVER_RESPONSE (Status " .. tostring(statusCode) .. ")"
            end
        else
            local errStr = tostring(res or "Timeout")
            lastError = "CONNECTION_FAILED (" .. errStr:sub(1, 35) .. ")"
        end
    end
    if lastFailData then
        return lastFailData, nil
    end
    return nil, lastError or "SERVER_UNREACHABLE"
end

