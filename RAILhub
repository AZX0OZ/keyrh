if startupKey ~= "" then
    local session, verr = requestServerSession(startupKey)
    if not session and not startupKey:find("RAIL|hub-", 1, true) then
        local prefKey = "RAIL|hub-" .. startupKey
        local prefSession, prefErr = requestServerSession(prefKey)
        if prefSession then
            startupKey = prefKey
            session = prefSession
            verr = nil
        else
            verr = prefErr or verr
        end
    end
    if session then
        saveKey(startupKey)
        pcall(function()
            _G.RAILhub_KeyAuthorized = true
            if getgenv then
                getgenv().SCRIPT_KEY = startupKey
                getgenv().RAILhub_KeyAuthorized = true
            end
            if shared then
                shared.RAILhub_KeyAuthorized = true
            end
        end)
        exportKeyRuntimeData(session.data or verifiedKeyData, startupKey)
        runMainScriptDirect(session)
        return
    end

    startupError = verr

    local isNetworkDown = (verr == "SERVER_UNREACHABLE" or (type(verr) == "string" and verr:find("CONNECTION_FAILED", 1, true)) or verr == "NO_HTTP_SUPPORT")
    if isNetworkDown then
        local junkieInst = ensureJunkieSDK()
        if junkieInst then
            local okCheck, checkRes = pcall(function()
                return junkieInst.check_key(startupKey)
            end)
            if okCheck and type(checkRes) == "table" and checkRes.valid == true then
                local fallbackSession = { token = "fallback_valid", exp = 0, data = checkRes }
                saveKey(startupKey)
                pcall(function()
                    if getgenv then
                        getgenv().SCRIPT_KEY = startupKey
                    end
                end)
                exportKeyRuntimeData(checkRes, startupKey)
                runMainScriptDirect(fallbackSession)
                return
            end
        end
    end
end

