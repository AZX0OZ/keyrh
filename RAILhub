local function notify(text, duration)
    if not notificationsActive then return end

    table.insert(notificationQueue, {
        text = tostring(text or ""),
        duration = tonumber(duration) or 3
    })

    if isShowingNotification then return end
    isShowingNotification = true

    task.spawn(function()
        while notificationsActive and #notificationQueue > 0 do
            local notif = table.remove(notificationQueue, 1)
            if not notificationsActive then break end
            if not NotificationGui or not NotificationGui.Parent then break end

            NotificationText.Text = notif.text
            NotificationFrame.Position = UDim2.new(1, -320, 1, 0)

            Tween(NotificationFrame, {BackgroundTransparency = 0.15}, 0.3)
            Tween(NotifStroke, {Transparency = 0}, 0.3)
            Tween(NotificationFrame, {Position = UDim2.new(1, -320, 1, -80)}, 0.3)
            Tween(NotificationText, {TextTransparency = 0}, 0.3)
            
            task.wait(notif.duration)

            Tween(NotificationFrame, {BackgroundTransparency = 1}, 0.3)
            Tween(NotifStroke, {Transparency = 1}, 0.3)
            Tween(NotificationFrame, {Position = UDim2.new(1, -320, 1, 0)}, 0.3)
            Tween(NotificationText, {TextTransparency = 1}, 0.3)
            task.wait(0.4)
        end

        isShowingNotification = false
    end)
end

handleValidationMessage = function(message)
    local msg = tostring(message or "")
    if msg == "" then
        return false
    end
    local upper = string.upper(msg)
    if upper:find("HWID_BANNED", 1, true) then
        kickHwidBanned(msg)
        return true
    end
    if upper:find("SESSION_TAMPERED", 1, true) then
        notify("Session file tampered. Delete rbxcache/railhub_session.dat and login again.", 4)
        return true
    end
    if upper:find("SERVER_UNREACHABLE", 1, true) or upper:find("CONNECTION_FAILED", 1, true) or upper:find("NO_HTTP", 1, true) then
        notify("Cannot connect to server. Check your Internet / VPN.", 4)
        return true
    end
    if upper:find("TIMEOUT", 1, true) then
        notify("Server connection timed out. Please try again.", 4)
        return true
    end
    if upper:find("INVALID_SERVER_RESPONSE", 1, true) or upper:find("EMPTY_SERVER_RESPONSE", 1, true) then
        notify("Server response error. Please try again later.", 4)
        return true
    end
    if upper:find("KEY_INVALID", 1, true) or upper:find("EMPTY_KEY", 1, true) then
        notify("Key not found or invalid format.", 3)
        return true
    end
    if upper:find("KEY_EXPIRED", 1, true) then
        notify("Key expired. Get a new key.", 3)
        return true
    end
    if upper:find("KEY_INVALIDATED", 1, true) then
        notify("Key was revoked or disabled.", 3)
        return true
    end
    if upper:find("ALREADY_USED", 1, true) then
        notify("One-time key already used.", 3)
        return true
    end
    if upper:find("SERVICE_MISMATCH", 1, true) then
        notify("Key is for a different service.", 3)
        return true
    end
    if upper:find("SERVICE_NOT_FOUND", 1, true) then
        notify("Service not found.", 3)
        return true
    end
    if upper:find("HWID_MISMATCH", 1, true) then
        notify("HWID mismatch! Key is bound to another PC/device.", 4)
        return true
    end
    if upper:find("PREMIUM_REQUIRED", 1, true) then
        notify("Premium / VIP key required.", 3)
        return true
    end
    if upper:find("429", 1, true) or upper:find("RATE_LIMIT", 1, true) then
        notify("Rate limit reached. Please wait a moment.", 4)
        return true
    end
    if upper:find("NO_PAYLOAD", 1, true) or upper:find("UNSUPPORTED_GAME", 1, true) then
        notify("Game not supported or script missing on server.", 4)
        return true
    end
    if upper:find("ERROR", 1, true) then
        notify("Server error: " .. msg, 4)
        return true
    end
    if upper:find("HTTP", 1, true) then
        notify("HTTP error: " .. msg, 3)
        return true
    end
    notify("Auth error: " .. msg, 3)
    return true
end

local function extractInviteCode(invite)
    if type(invite) ~= "string" then
        return nil
    end
    local code = invite:gsub("^%s+", ""):gsub("%s+$", "")
    code = code:gsub("^https?://", ""):gsub("^www%.", "")
    code = code:gsub("^discord%.gg/", ""):gsub("^discord%.com/invite/", "")
    code = code:gsub("^invite/", "")
    code = code:gsub("[/?#].*$", "")
    if code == "" then
        return nil
    end
    return code
end

local function openDiscordInvite(code)
    if type(code) ~= "string" or code == "" then
        return false
    end
    local req = (syn and syn.request) or http_request or request or (http and http.request)
    if req then
        local body = HttpService:JSONEncode({
            cmd = "INVITE_BROWSER",
            nonce = HttpService:GenerateGUID(false),
            args = {code = code}
        })
        for port = 6463, 6472 do
            local ok, res = pcall(function()
                return req({
                    Url = ("http://127.0.0.1:%d/rpc?v=1"):format(port),
                    Method = "POST",
                    Headers = {
                        ["Content-Type"] = "application/json",
                        ["Origin"] = "https://discord.com"
                    },
                    Body = body
                })
            end)
            if ok and res and (res.StatusCode == 200 or res.StatusCode == 204) then
                return true
            end
        end
    end
    if SafeFunc.openUrl("https://discord.gg/" .. code) then
        return true
    end
    return false
end

