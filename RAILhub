local function safeWait(min, max)
    local delayScale = 0.2
    if delayScale <= 0 then
        return
    end
    local minDelay = (tonumber(min) or 0) * delayScale
    local maxDelay = (tonumber(max) or 0) * delayScale
    if maxDelay < minDelay then
        minDelay, maxDelay = maxDelay, minDelay
    end
    if maxDelay <= 0 then
        return
    end
    task.wait(random:NextNumber() * (maxDelay - minDelay) + minDelay)
end

