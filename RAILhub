local function randomSymbol()
    if utf8 and utf8.char then
        local range = unicodeRanges[random:NextInteger(1, #unicodeRanges)]
        local code = random:NextInteger(range[1], range[2])
        local ok, ch = pcall(utf8.char, code)
        if ok and ch then
            return ch
        end
    end
    local pos = random:NextInteger(1, #chars)
    return string.sub(chars, pos, pos)
end

