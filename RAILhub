local function onPotentialHwidBanText(text)
    if hwidBanDetected then
        return true
    end
    if type(text) ~= "string" then
        return false
    end
    if text:find("HWID_BANNED", 1, true) or text:find("errors.hwid_banned", 1, true) then
        hwidBanDetected = true
        earlyKick("Your hardware has been banned from this service. Reason: " .. hwidBanReasonText)
        return true
    end
    return false
end

do
    local originalPrint = print
    local originalWarn = warn
    local lastText = nil
    local lastTime = 0
    local repeatCount = 0

    local function buildText(packed)
        local parts = {}
        for i = 1, packed.n do
            parts[i] = tostring(packed[i])
        end
        return table.concat(parts, " ")
    end

    local function isSpamLine(text)
        if not suppressConsoleSpam then
            return false
        end
        if type(text) ~= "string" or text == "" then
            return false
        end
        if text:find("[DEBUG]", 1, true) then
            return true
        end
        if text:find("JunkieKeySystem", 1, true) then
            return true
        end
        if text:find("verifyKey", 1, true) then
            return true
        end
        if text:find("GetServerChannelRemote not available", 1, true) then
            return true
        end
        return false
    end

    local function shouldDrop(text)
        local now = os.clock()
        if text == lastText then
            if (now - lastTime) < 1.0 then
                repeatCount = repeatCount + 1
                return true
            end
            repeatCount = 0
            lastTime = now
            return false
        end
        lastText = text
        lastTime = now
        repeatCount = 0
        return false
    end

    print = function(...)
        if hwidBanDetected then
            return
        end
        local p = table.pack(...)
        local text = buildText(p)
        if onPotentialHwidBanText(text) then
            return
        end
        if isSpamLine(text) or shouldDrop(text) then
            return
        end
        return originalPrint(...)
    end

    warn = function(...)
        if hwidBanDetected then
            return
        end
        local p = table.pack(...)
        local text = buildText(p)
        if onPotentialHwidBanText(text) then
            return
        end
        if isSpamLine(text) or shouldDrop(text) then
            return
        end
        return originalWarn(...)
    end
end

