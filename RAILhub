local function checkKeyWithRetries(key, attempts, delaySeconds)
    local lastErr = nil
    attempts = attempts or 3
    delaySeconds = delaySeconds or 60
    local junkieInst = ensureJunkieSDK()
    if not junkieInst then
        return false, "SDK_NOT_AVAILABLE", nil
    end
    for i = 1, attempts do
        local okVerify, res = pcall(function()
            return junkieInst.check_key(key)
        end)
        if okVerify then
            local isValid, err = parseValidationResult(res)
            if isValid then
                if type(res) == "table" then
                    verifiedKeyData = res
                end
                local exp = parseExpirationToTimestamp(findDeepField(res, {
                    "expires_at", "expiresAt", "expire_at", "expireAt",
                    "expiration", "expires", "valid_until", "validUntil",
                    "expiry", "time_left", "remaining"
                }))
                saveSessionLocal(key, res, exp)
                return true, nil, res
            end
            local up = string.upper(tostring(err or ""))
            if up:find("429", 1, true) or up:find("RATE_LIMIT", 1, true) then
                lastErr = err
                if i < attempts then
                    pcall(function() notify("Rate limited. Retrying in 60s...", 4) end)
                    task.wait(delaySeconds)
                end
            else
                return false, err, res
            end
        else
            lastErr = "REQUEST_ERROR"
            if i < attempts then
                task.wait(delaySeconds)
            end
        end
    end
    return false, lastErr, nil
end

